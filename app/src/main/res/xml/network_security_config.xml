<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Block all unencrypted cleartext HTTP traffic across the application -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config>
        <!-- Restrict TLS to secure HTTPS endpoints for all enterprise APIs -->
        <domain includeSubdomains="true">generativelanguage.googleapis.com</domain>
        <domain includeSubdomains="true">api.openweathermap.org</domain>
        <domain includeSubdomains="true">api.shifthr.com</domain>
        <domain includeSubdomains="true">googleapis.com</domain>
    </domain-config>
</network-security-config>
