<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Disallow cloud backup extraction of local databases and security credentials -->
        <exclude domain="database" path="time_tracker_database" />
        <exclude domain="database" path="shift_tracker_database" />
        <exclude domain="sharedpref" path="security_credentials.xml" />
        <exclude domain="sharedpref" path="app_auth_session.xml" />
        <exclude domain="file" path="security_keys" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="time_tracker_database" />
        <exclude domain="database" path="shift_tracker_database" />
        <exclude domain="sharedpref" path="security_credentials.xml" />
        <exclude domain="sharedpref" path="app_auth_session.xml" />
        <exclude domain="file" path="security_keys" />
    </device-transfer>
</data-extraction-rules>
